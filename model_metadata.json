{
    "model_name": "fraud_detector",
    "model_type": "RandomForestClassifier",
    "features": [
        "amount",
        "hour",
        "num_tx_past_day"
    ],
    "target": "is_fraud",
    "random_state": 42,
    "n_estimators": 100,
    "metrics": {
        "accuracy": 1.0,
        "precision": 1.0,
        "recall": 1.0,
        "f1": 1.0
    }
}